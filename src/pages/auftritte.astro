---
import BaseLayout from '@layouts/BaseLayout.astro';
import ConcertList from '@components/ConcertList.astro';
import { getConcerts, getPastConcerts, getUpcomingConcerts } from '@lib/content';
import { sitePath } from '@lib/paths';
import { calendarFiles } from '@lib/calendar';

const concerts = await getConcerts();
const files = calendarFiles(concerts);
const upcoming = getUpcomingConcerts(concerts);
const past = getPastConcerts(concerts);
const feedUrl = new URL(sitePath('/auftritte.ics'), Astro.site || Astro.url.origin);
const subscriptionUrl = feedUrl.href.replace(/^https?:/, 'webcal:');
---

<BaseLayout title="Auftritte">
  <section class="page-hero compact-hero performances-intro">
    <p class="eyebrow">Live</p>
    <h1>Auftritte</h1>
    <p>Alle bestätigten Konzerte, privaten Events und öffentlichen Austropop-Abende auf einen Blick.</p>
  </section>

  <section class="content-band performances-content">
    <details class="calendar-menu calendar-subscribe">
      <summary>Alle Auftritte abonnieren</summary>
      <div class="calendar-options">
        <a href={subscriptionUrl}>Apple Calendar / Outlook</a>
        <a href={`https://calendar.google.com/calendar/r?${new URLSearchParams({ cid: feedUrl.href })}`} target="_blank" rel="noopener noreferrer">Google Calendar</a>
        <a href={feedUrl.href}>Kalender-Feed (.ics)</a>
      </div>
    </details>
    <div class="performance-tabs" data-performance-tabs>
      <div class="tab-bar" role="tablist" aria-label="Auftritte filtern">
        <button class="tab-button active" type="button" role="tab" aria-selected="true" aria-controls="upcoming-performances" id="tab-upcoming" data-tab-target="upcoming-performances">
          <span class="tab-label">Kommende<span class="tab-label-suffix"> Auftritte</span></span>
          <span class="tab-count">{upcoming.length}</span>
        </button>
        <button class="tab-button" type="button" role="tab" aria-selected="false" aria-controls="past-performances" id="tab-past" data-tab-target="past-performances">
          <span class="tab-label">Vergangene<span class="tab-label-suffix"> Auftritte</span></span>
          <span class="tab-count">{past.length}</span>
        </button>
      </div>

      <div class="tab-panel" id="upcoming-performances" role="tabpanel" aria-labelledby="tab-upcoming">
        <ConcertList concerts={upcoming} calendarFiles={files} emptyText="Keine kommenden Auftritte vorhanden." />
      </div>
      <div class="tab-panel" id="past-performances" role="tabpanel" aria-labelledby="tab-past" hidden>
        <ConcertList concerts={past} calendarFiles={files} emptyText="Noch keine vergangenen Auftritte vorhanden." />
      </div>
    </div>
  </section>

  <script>
    const tabRoot = document.querySelector('[data-performance-tabs]');

    if (tabRoot instanceof HTMLElement) {
      const buttons = [...tabRoot.querySelectorAll<HTMLButtonElement>('[data-tab-target]')];
      const panels = [...tabRoot.querySelectorAll<HTMLElement>('.tab-panel')];

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.dataset.tabTarget;

          buttons.forEach((item) => {
            const isActive = item === button;
            item.classList.toggle('active', isActive);
            item.setAttribute('aria-selected', String(isActive));
          });

          panels.forEach((panel) => {
            panel.hidden = panel.id !== target;
          });
        });
      });
    }
  </script>
</BaseLayout>
