---
import { sitePath } from '@lib/paths';
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getSiteSettings } from '@lib/content';

interface Props {
  title?: string;
  description?: string;
  immersiveHeader?: boolean;
}

const settings = await getSiteSettings();
const pageTitle = Astro.props.title ? `${Astro.props.title} | ${settings.title}` : settings.title;
const description = Astro.props.description || settings.intro;
---

<!doctype html>
<html lang="de" class:list={{ 'standard-header-page': !Astro.props.immersiveHeader, 'immersive-header-page': Astro.props.immersiveHeader }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={Astro.props.immersiveHeader ? '#000000' : '#fffaf1'} />
    <link rel="icon" href={sitePath('/images/logo.webp')} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <Header settings={settings} immersive={Astro.props.immersiveHeader} />
    <main>
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
